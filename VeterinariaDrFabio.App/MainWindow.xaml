<Window x:Class="VeterinariaDrFabio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vistas="clr-namespace:VeterinariaDrFabio.App.Vistas"
        xmlns:vm="clr-namespace:VeterinariaDrFabio.App.ViewModels"
        Title="{Binding NombreSistema}" Height="720" Width="1180" MinHeight="680" MinWidth="1024"
        FontFamily="Segoe UI" Background="{StaticResource FondoBrush}">
    <Window.Resources>
        <!-- Cada ViewModel de pantalla se muestra con su vista -->
        <DataTemplate DataType="{x:Type vm:PropietariosViewModel}">
            <vistas:PropietariosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PropietarioEdicionViewModel}">
            <vistas:PropietarioEdicionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MascotasViewModel}">
            <vistas:MascotasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MascotaEdicionViewModel}">
            <vistas:MascotaEdicionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MascotaDetalleViewModel}">
            <vistas:MascotaDetalleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcedimientoEdicionViewModel}">
            <vistas:ProcedimientoEdicionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VacunacionEdicionViewModel}">
            <vistas:VacunacionEdicionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CarnetViewModel}">
            <vistas:CarnetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertasViewModel}">
            <vistas:AlertasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfiguracionViewModel}">
            <vistas:ConfiguracionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VeterinariosViewModel}">
            <vistas:VeterinariosView />
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource FondoBrush}">
        <!-- P-01 Login: visible mientras no haya sesión -->
        <Grid x:Name="VistaLogin" Visibility="{Binding MostrarLogin, Converter={StaticResource BoolAVisibilidad}}">
            <vistas:LoginView DataContext="{Binding Login}" />
        </Grid>

        <!-- P-02 Shell: menú lateral fijo, encabezado y área de contenido -->
        <DockPanel x:Name="VistaPrincipal" LastChildFill="True"
                   Visibility="{Binding SesionActiva, Converter={StaticResource BoolAVisibilidad}}">
            <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource PrimarioBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding NombreSistema}" Foreground="White" FontSize="16"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="24,28,24,28" />
                    <ItemsControl ItemsSource="{Binding Secciones}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Titulo}" Style="{StaticResource BotonMenu}"
                                        CommandParameter="{Binding Titulo}"
                                        Command="{Binding DataContext.NavegarSeccionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Height="64" Background="{StaticResource SuperficieBrush}"
                    BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="28,0">
                    <Button DockPanel.Dock="Right" Content="Cerrar sesión" Style="{StaticResource BotonSecundario}"
                            VerticalAlignment="Center" Command="{Binding CerrarSesionCommand}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding NombreUsuario}" Style="{StaticResource EtiquetaTexto}"
                               VerticalAlignment="Center" Margin="0,0,20,0" />
                    <TextBlock Text="{Binding SeccionActual}" Style="{StaticResource TituloTexto}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ContentControl Margin="28" Content="{Binding Navegacion.ViewModelActual}" />
        </DockPanel>
    </Grid>
</Window>
