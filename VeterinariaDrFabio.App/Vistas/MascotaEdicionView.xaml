<UserControl x:Class="VeterinariaDrFabio.App.Vistas.MascotaEdicionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Tarjeta}" Padding="32" Width="700" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock x:Name="TituloFormulario" Text="{Binding Titulo}" Style="{StaticResource TituloTexto}" Margin="0,0,0,24" />

                <!-- Propietario -->
                <TextBlock Text="Propietario (obligatorio)" Style="{StaticResource EtiquetaTexto}" />
                <ComboBox x:Name="CampoPropietario" Height="36" Margin="0,4,0,4" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Propietarios}" DisplayMemberPath="Texto" SelectedItem="{Binding PropietarioSeleccionado}" />
                <TextBlock x:Name="AvisoSinPropietarios" Style="{StaticResource ErrorTexto}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="No hay propietarios registrados. Primero registre uno en la sección Propietarios."
                           Visibility="{Binding NoHayPropietarios, Converter={StaticResource BoolAVisibilidad}}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="Nombre (obligatorio)" Style="{StaticResource EtiquetaTexto}" />
                        <TextBox x:Name="CampoNombre" Margin="0,4,0,0" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="Especie (obligatoria)" Style="{StaticResource EtiquetaTexto}" />
                        <ComboBox x:Name="CampoEspecie" Height="36" Margin="0,4,0,0" IsEditable="True" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding EspeciesSugeridas}" Text="{Binding Especie, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="Raza" Style="{StaticResource EtiquetaTexto}" />
                        <TextBox x:Name="CampoRaza" Margin="0,4,0,0" Text="{Binding Raza, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="Sexo" Style="{StaticResource EtiquetaTexto}" />
                        <ComboBox x:Name="CampoSexo" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding OpcionesSexo}" SelectedItem="{Binding SexoSeleccionado}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="Fecha de nacimiento (obligatoria)" Style="{StaticResource EtiquetaTexto}" />
                        <DatePicker x:Name="CampoFechaNacimiento" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"
                                    SelectedDate="{Binding FechaNacimiento, Mode=TwoWay}" DisplayDateEnd="{Binding FechaMaxima, Mode=OneWay}" />
                        <CheckBox x:Name="CampoFechaEstimada" Content="La fecha es estimada" Margin="0,8,0,0"
                                  IsChecked="{Binding FechaEstimada}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="Edad calculada" Style="{StaticResource EtiquetaTexto}" />
                        <TextBlock x:Name="EdadCalculada" Text="{Binding EdadCalculada, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextoPrincipalBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,16">
                        <TextBlock Text="Peso en kg (obligatorio)" Style="{StaticResource EtiquetaTexto}" />
                        <TextBox x:Name="CampoPeso" Margin="0,4,0,4" Text="{Binding PesoTexto, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock x:Name="ErrorPeso" Text="{Binding ErrorPeso, Mode=OneWay}" Style="{StaticResource ErrorTexto}" TextWrapping="Wrap"
                                   Visibility="{Binding TieneErrorPeso, Converter={StaticResource BoolAVisibilidad}}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,16">
                        <TextBlock Text="Color o señas" Style="{StaticResource EtiquetaTexto}" />
                        <TextBox x:Name="CampoColorSenas" Margin="0,4,0,0" Text="{Binding ColorSenas, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="MensajeError" Text="{Binding MensajeError, Mode=OneWay}" Style="{StaticResource ErrorTexto}" TextWrapping="Wrap"
                           Margin="0,0,0,12" Visibility="{Binding TieneError, Converter={StaticResource BoolAVisibilidad}}" />

                <DockPanel Margin="0,8,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="Guardar" Style="{StaticResource BotonPrimario}" IsDefault="True"
                            Command="{Binding GuardarCommand}" />
                    <Button DockPanel.Dock="Left" Content="Cancelar" Style="{StaticResource BotonSecundario}" Margin="12,0,0,0"
                            IsCancel="True" Command="{Binding CancelarCommand}" />
                    <Button x:Name="BotonCambiarEstado" DockPanel.Dock="Right" Content="{Binding TextoCambiarEstado}"
                            Style="{StaticResource BotonSecundario}" Command="{Binding CambiarEstadoCommand}"
                            Visibility="{Binding EsEdicion, Converter={StaticResource BoolAVisibilidad}}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
