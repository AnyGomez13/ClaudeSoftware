<UserControl x:Class="VeterinariaDrFabio.App.Vistas.MascotasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Búsqueda y alta -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Nueva mascota" Style="{StaticResource BotonPrimario}"
                    Command="{Binding NuevaMascotaCommand}" />
            <StackPanel Margin="0,0,24,0">
                <TextBlock Text="Buscar por nombre de la mascota o del propietario" Style="{StaticResource EtiquetaTexto}" />
                <TextBox x:Name="CampoBusqueda" Margin="0,4,0,0" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DockPanel>

        <!-- Tabla de mascotas -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}">
            <Grid>
                <DataGrid x:Name="TablaMascotas" ItemsSource="{Binding Mascotas}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mascota" Binding="{Binding Nombre}" Width="1.5*" MinWidth="90" />
                        <DataGridTextColumn Header="Especie" Binding="{Binding Especie}" Width="*" MinWidth="70" />
                        <DataGridTextColumn Header="Propietario" Binding="{Binding Propietario}" Width="2*" MinWidth="110" />
                        <DataGridTextColumn Header="Edad" Binding="{Binding Edad}" Width="1.5*" MinWidth="150" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="0.8*" MinWidth="80" />
                        <DataGridTemplateColumn Header="" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Abrir ficha" Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                                                Command="{Binding DataContext.AbrirFichaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Editar" Style="{StaticResource BotonSecundario}"
                                                Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="MensajeSinResultados" Text="No se encontraron mascotas." Style="{StaticResource EtiquetaTexto}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SinResultados, Converter={StaticResource BoolAVisibilidad}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
