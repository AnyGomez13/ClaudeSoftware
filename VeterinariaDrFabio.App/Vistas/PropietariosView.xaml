<UserControl x:Class="VeterinariaDrFabio.App.Vistas.PropietariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Búsqueda y alta -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Nuevo propietario" Style="{StaticResource BotonPrimario}"
                    Command="{Binding NuevoPropietarioCommand}" />
            <StackPanel Margin="0,0,24,0">
                <TextBlock Text="Buscar por nombre o teléfono" Style="{StaticResource EtiquetaTexto}" />
                <TextBox x:Name="CampoBusqueda" Margin="0,4,0,0" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DockPanel>

        <!-- Tabla de propietarios -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}">
            <Grid>
                <DataGrid x:Name="TablaPropietarios" ItemsSource="{Binding Propietarios}" SelectedItem="{Binding Seleccionado, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="3*" />
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="*" />
                        <DataGridTextColumn Header="Mascotas" Binding="{Binding NumeroMascotas}" Width="0.8*" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="0.8*" />
                        <DataGridTemplateColumn Header="" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Ver" Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                                                Command="{Binding DataContext.VerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Editar" Style="{StaticResource BotonSecundario}"
                                                Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="MensajeSinResultados" Text="No se encontraron propietarios." Style="{StaticResource EtiquetaTexto}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SinResultados, Converter={StaticResource BoolAVisibilidad}}" />
            </Grid>
        </Border>

        <!-- Mascotas del propietario seleccionado -->
        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Margin="0,16,0,0" Padding="16" MaxHeight="220"
                Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisibilidad}}">
            <StackPanel>
                <TextBlock x:Name="TituloMascotas" Text="{Binding TituloMascotas}" Style="{StaticResource TituloTexto}" FontSize="16" />
                <TextBlock x:Name="MensajeSinMascotas" Text="Este propietario aún no tiene mascotas registradas." Margin="0,8,0,0"
                           Style="{StaticResource EtiquetaTexto}"
                           Visibility="{Binding SeleccionSinMascotas, Converter={StaticResource BoolAVisibilidad}}" />
                <DataGrid x:Name="TablaMascotas" ItemsSource="{Binding Mascotas}" Margin="0,8,0,0" MaxHeight="150">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mascota" Binding="{Binding Nombre}" Width="2*" />
                        <DataGridTextColumn Header="Especie" Binding="{Binding Especie}" Width="*" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
